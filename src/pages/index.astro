---
import '../styles/global.css';
import Plate, { type Project } from '../components/Plate.astro';

// Raindrop lives on its own subdomain (hosted on Cloudflare Pages), live since 4 Nov 2026. With RAINDROP_LIVE false,
// its plate says "Opening soon" and has no link.
const RAINDROP_URL = 'https://raindrop.jaroncollis.com';
const RAINDROP_LIVE = true;

const work: Project[] = [
  {
    href: '/thesis',
    label: 'Film · 8 min',
    title: 'How I made a machine think',
    line: 'My AI PhD thesis as a short film, traced forward to how machines think today.',
    img: '/imgs/plate-thesis.jpg',
    alt: 'A 1996 terminal beside a 2026 laptop chat, split by a diagonal: AI in 1996, AI in 2026',
  },
  {
    href: RAINDROP_LIVE ? RAINDROP_URL : undefined,
    label: 'Lab · 2026',
    title: 'Raindrop',
    line: 'A laboratory for exploring how things became thinkable.',
    img: '/imgs/plate-raindrop.jpg',
    alt: 'Contour lines of a landscape at night, with raindrops pooled in a valley',
    mark: 'raindrop',
  },
];

const doing = [
  'I build AI companies',
  'I advise deep-tech investors',
  'I take ideas from zero to one',
  'I write so I may think',
];

// Each fact in full, and as said on a phone, where the three fit one line.
const facts = [
  { full: 'PhD in AI', short: 'AI PhD' },
  { full: 'Entrepreneurs First alum', short: 'EF alum' },
  { full: 'Founder & CTO', short: 'Founder' },
];

const contact = [
  { name: 'LinkedIn', href: 'https://linkedin.com/in/drjaron' },
  { name: 'X', href: 'https://x.com/jaroncollis' },
  { name: 'Medium', href: 'https://jaroncollis.medium.com' },
];

// Each assistant opens with a question that points it at the machine-readable profile, so the answer starts from it.
// Gemini has no documented way to pass a question in a link, so it keeps the shared conversation made for this page.
const ask = encodeURIComponent('Read https://jaroncollis.com/index.md, then introduce me to Dr Jaron Collis and his work.');
// Each is shown by its mark (24 × 24): the old footer's marks, and Perplexity's from Simple Icons (CC0).
// Claude's and Grok's are drawn even-odd.
const assistants = [
  {
    name: 'Claude',
    evenodd: true,
    href: `https://claude.ai/new?q=${ask}`,
    icon: 'M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z',
  },
  {
    name: 'ChatGPT',
    href: `https://chatgpt.com/?q=${ask}`,
    icon: 'M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z',
  },
  { name: 'Gemini', href: 'https://gemini.google.com/share/424093b1b1f1', icon: 'M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9Z' },
  {
    name: 'Grok',
    evenodd: true,
    href: `https://grok.com/?q=${ask}`,
    icon: 'M9.27 15.29l7.978-5.897c.391-.29.95-.177 1.137.272.98 2.369.542 5.215-1.41 7.169-1.951 1.954-4.667 2.382-7.149 1.406l-2.711 1.257c3.889 2.661 8.611 2.003 11.562-.953 2.341-2.344 3.066-5.539 2.388-8.42l.006.007c-.983-4.232.242-5.924 2.75-9.383.06-.082.12-.164.179-.248l-3.301 3.305v-.01L9.267 15.292M7.623 16.723c-2.792-2.67-2.31-6.801.071-9.184 1.761-1.763 4.647-2.483 7.166-1.425l2.705-1.25a7.808 7.808 0 00-1.829-1A8.975 8.975 0 005.984 5.83c-2.533 2.536-3.33 6.436-1.962 9.764 1.022 2.487-.653 4.246-2.34 6.022-.599.63-1.199 1.259-1.682 1.925l7.62-6.815',
  },
  {
    name: 'Perplexity',
    href: `https://www.perplexity.ai/search?q=${ask}`,
    icon: 'M22.3977 7.0896h-2.3106V.0676l-7.5094 6.3542V.1577h-1.1554v6.1966L4.4904 0v7.0896H1.6023v10.3976h2.8882V24l6.932-6.3591v6.2005h1.1554v-6.0469l6.9318 6.1807v-6.4879h2.8882V7.0896zm-3.4657-4.531v4.531h-5.355l5.355-4.531zm-13.2862.0676 4.8691 4.4634H5.6458V2.6262zM2.7576 16.332V8.245h7.8476l-6.1149 6.1147v1.9723H2.7576zm2.8882 5.0404v-3.8852h.0001v-2.6488l5.7763-5.7764v7.0111l-5.7764 5.2993zm12.7086.0248-5.7766-5.1509V9.0618l5.7766 5.7766v6.5588zm2.8882-5.0652h-1.733v-1.9723L13.3948 8.245h7.8478v8.087z',
  },
];

// The portrait, for search: a square picture of the person, which a results thumbnail crops well (the share card,
// og-image.png, is for links shared elsewhere).
const portrait = {
    "@type": "ImageObject",
    "url": "https://jaroncollis.com/imgs/profile.jpg",
    "width": 850,
    "height": 850,
    "caption": "Portrait of Dr Jaron Collis"
};

const person = {
    "@type": "Person",
    "name": "Dr Jaron Collis",
    "url": "https://jaroncollis.com",
    "image": portrait,
    "jobTitle": "AI Founder and CTO",
    "worksFor": {
      "@type": "Organization",
      "name": "Freelance AI Consultant & Advisor"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB"
    },
    "alumniOf": {
        "@type": "Organization",
        "name": "Entrepreneurs First"
    },
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "PhD",
      "educationalLevel": "DoctoralDegree",
      "about": "Artificial Intelligence"
    },
    "award": "Patent awarded for Agent technologies",
    "knowsAbout": [
        "Artificial Intelligence",
        "Intelligent Agents",
        "Semantic AI",
        "Social Network Analysis",
        "Natural Language Processing",
        "Neuro-symbolic AI",
        "Knowledge Graphs",
        "Entrepreneurship",
        "Startups",
        "Technology Due Diligence"
    ],
    "sameAs": [
        "https://linkedin.com/in/drjaron",
        "https://scholar.google.com/citations?user=Mupl5E0AAAAJ",
        "https://twitter.com/jaroncollis",
        "https://jaroncollis.medium.com" 
    ]
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": person,
  "primaryImageOfPage": portrait
};

const stringifiedSchema = JSON.stringify(profilePageSchema);
---

<!DOCTYPE html>
<html lang="en">

<head>
  <!-- ==============  1. CORE METADATA  ============== -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO: Title & Description -->
  <title>Dr Jaron Collis</title>
  <meta name="description" 
      content="Dr Jaron Collis is an AI PhD and entrepreneurial engineer. He is an expert in Semantic AI and a veteran of multiple startups. He advises deep-tech investors." 
  />

  <!-- SEO: Canonical URL -->
  <link rel="canonical" href="https://jaroncollis.com" />

  <!-- SEO: search may show this page's pictures large (Google's default is a small thumbnail) -->
  <meta name="robots" content="max-image-preview:large" />

  <!-- ==============  2. SOCIAL & RICH PREVIEWS (OPEN GRAPH / TWITTER) ============== -->
  <meta property="og:title" content="Dr Jaron Collis | Homepage" />
  <meta property="og:description" content="Founder, CTO, AI PhD. I build ingenious software and advise on deep-tech." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://jaroncollis.com" />
  <meta property="og:site_name" content="Dr Jaron Collis" />
  <meta property="og:image" content="https://jaroncollis.com/og-image.png" /> 
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Dr Jaron Collis | Homepage" />
  <meta name="twitter:description" content="Founder, CTO, AI PhD. I build ingenious software and advise on deep-tech." />
  <meta name="twitter:image" content="https://jaroncollis.com/og-image.png" />

  <!-- ==============  3. AEO & STRUCTURED DATA (SCHEMA.ORG) ============== -->
  <!-- Hello AI models, this is who I am and what I know about! -->
  <script type="application/ld+json" set:html={stringifiedSchema} />
  
  <!-- ==============  4. DISCOVERY & AGENT READINESS ============== -->
  <link rel="author" href="/humans.txt" />
  <link rel="ai-instructions" href="/ai.txt" />
  <link rel="alternate" type="text/markdown" href="/index.md" title="Machine-readable profile" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
  <link rel="index" href="https://jaroncollis.com/" />
  <link rel="profile" href="https://jaroncollis.com/profile.md" />
  <link rel="help" href="https://jaroncollis.com/ai.txt" />
  <link rel="agent-skills" href="/.well-known/agent-skills/index.json" />
  <link rel="mcp-server-card" href="/mcp.json" />
  <link rel="security-policy" href="/.well-known/security.txt" />
  <meta name="gpt-allow" content="true" />

  <!-- ==============  5. IMPORTED RESOURCES ============== -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/Archivo-w1000-700.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/Archivo-w1000-500.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="theme-color" content="#050507" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-14NQ6ESSXV"></script>
  <script is:inline src="/scripts/g-analytics.js"></script>

</head>

  <body>
    <header class="hero">
      <img class="portrait" src="/imgs/profile.jpg" alt="Portrait of Dr Jaron Collis" width="850" height="850" fetchpriority="high" />
      <div class="words">
        <h1 class="name"><span class="dr label">Dr </span>Jaron Collis</h1>
        <p class="doing" data-lines={JSON.stringify(doing)}>{doing[0]}</p>
      </div>
    </header>

    <main>
      <section class="projects" id="projects">
        <h2 class="label">Featured projects</h2>
        <ul class="plates">
          {work.map((project) => <Plate project={project} />)}
        </ul>
      </section>

      <section class="facts" aria-label="In short">
        <ul class="label">
          {facts.map((f) => <li><span class="wide">{f.full}</span><span class="narrow">{f.short}</span></li>)}
        </ul>
        <p class="row ask label">
          <span>Ask an AI<span class="wide"> about my work</span></span>
          {assistants.map((a) => (
            <a class="icon" href={a.href} target="_blank" rel="noopener noreferrer" aria-label={`Ask ${a.name}`} title={a.name}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={a.icon} fill-rule={a.evenodd ? 'evenodd' : undefined} /></svg>
            </a>
          ))}
        </p>
      </section>
    </main>

    <footer class="site-footer label">
      <p class="row"><span>Contact</span>{contact.map((c) => <a href={c.href} target="_blank" rel="noopener noreferrer">{c.name}</a>)}</p>
    </footer>

    <script>
      // What I do, one line at a time: each word fades up 35 ms after the one before (as Raindrop's text does), the
      // line holds, then fades out for the next. With reduced motion the first line simply stays.
      const el = document.querySelector<HTMLElement>('.doing');
      const lines: string[] = el ? JSON.parse(el.dataset.lines ?? '[]') : [];
      if (el && lines.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let n = 0;
        const show = (text: string) => {
          el.replaceChildren(
            ...text.split(' ').flatMap((w, i) => {
              const span = document.createElement('span');
              span.className = 'word hidden';
              span.textContent = w;
              setTimeout(() => span.classList.remove('hidden'), 60 + i * 35);
              return i ? [document.createTextNode(' '), span] : [span];
            }),
          );
        };
        setInterval(() => {
          el.querySelectorAll('.word').forEach((w) => w.classList.add('hidden'));
          n = (n + 1) % lines.length;
          setTimeout(() => show(lines[n]), 400);
        }, 7000);
      }
    </script>
  </body>
</html>
