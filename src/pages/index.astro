---
import '../styles/global.css';
import Plate, { type Project } from '../components/Plate.astro';

// Raindrop lives on its own subdomain (hosted on Cloudflare Pages), live since 4 Nov 2026. With RAINDROP_LIVE false,
// its plate says "Opening soon" and has no link.
const RAINDROP_URL = 'https://raindrop.jaroncollis.com';
const RAINDROP_LIVE = true;

const work: Project[] = [
  {
    href: '/thesis',
    label: 'Film · 8 min',
    title: 'How I made a machine think',
    line: 'My AI PhD thesis as a short film, traced forward to how machines think today.',
    img: '/imgs/plate-thesis.jpg',
    alt: 'A 1996 terminal beside a 2026 laptop chat, split by a diagonal: AI in 1996, AI in 2026',
  },
  {
    href: RAINDROP_LIVE ? RAINDROP_URL : undefined,
    label: 'Lab · 2026',
    title: 'Raindrop',
    line: 'A laboratory for exploring how things became thinkable.',
    img: '/imgs/plate-raindrop.jpg',
    alt: 'Contour lines of a landscape at night, with raindrops pooled in a valley',
    mark: 'raindrop',
  },
];

const doing = [
  'I build AI companies',
  'I advise deep-tech investors',
  'I take ideas from zero to one',
  'I write so I may think',
];

const facts = ['PhD in AI', 'Entrepreneurs First alum', 'Founder & CTO'];

const contact = [
  { name: 'LinkedIn', href: 'https://linkedin.com/in/drjaron' },
  { name: 'X', href: 'https://x.com/jaroncollis' },
  { name: 'Medium', href: 'https://jaroncollis.medium.com' },
];

// Each assistant opens with a question that points it at the machine-readable profile, so the answer starts from it.
// Gemini has no documented way to pass a question in a link, so it keeps the shared conversation made for this page.
const ask = encodeURIComponent('Read https://jaroncollis.com/index.md, then introduce me to Dr Jaron Collis and his work.');
const assistants = [
  { name: 'Claude', href: `https://claude.ai/new?q=${ask}` },
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${ask}` },
  { name: 'Gemini', href: 'https://gemini.google.com/share/424093b1b1f1' },
  { name: 'Grok', href: `https://grok.com/?q=${ask}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${ask}` },
];

const person = {
    "@type": "Person",
    "name": "Dr Jaron Collis",
    "url": "https://jaroncollis.com",
    "jobTitle": "AI Founder and CTO",
    "worksFor": {
      "@type": "Organization",
      "name": "Freelance AI Consultant & Advisor"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB"
    },
    "alumniOf": {
        "@type": "Organization",
        "name": "Entrepreneurs First"
    },
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "PhD",
      "educationalLevel": "DoctoralDegree",
      "about": "Artificial Intelligence"
    },
    "award": "Patent awarded for Agent technologies",
    "knowsAbout": [
        "Artificial Intelligence",
        "Intelligent Agents",
        "Semantic AI",
        "Social Network Analysis",
        "Natural Language Processing",
        "Neuro-symbolic AI",
        "Knowledge Graphs",
        "Entrepreneurship",
        "Startups",
        "Technology Due Diligence"
    ],
    "sameAs": [
        "https://linkedin.com/in/drjaron",
        "https://scholar.google.com/citations?user=Mupl5E0AAAAJ",
        "https://twitter.com/jaroncollis",
        "https://jaroncollis.medium.com" 
    ]
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": person
};

const stringifiedSchema = JSON.stringify(profilePageSchema);
---

<!DOCTYPE html>
<html lang="en">

<head>
  <!-- ==============  1. CORE METADATA  ============== -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO: Title & Description -->
  <title>Dr Jaron Collis</title>
  <meta name="description" 
      content="Dr Jaron Collis is an AI PhD and entrepreneurial engineer. He is an expert in Semantic AI and a veteran of multiple startups. He advises deep-tech investors." 
  />

  <!-- SEO: Canonical URL -->
  <link rel="canonical" href="https://jaroncollis.com" />

  <!-- ==============  2. SOCIAL & RICH PREVIEWS (OPEN GRAPH / TWITTER) ============== -->
  <meta property="og:title" content="Dr Jaron Collis | Homepage" />
  <meta property="og:description" content="Founder, CTO, AI PhD. I build ingenious software and advise on deep-tech." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://jaroncollis.com" />
  <meta property="og:site_name" content="Dr Jaron Collis" />
  <meta property="og:image" content="https://jaroncollis.com/og-image.png" /> 
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Dr Jaron Collis | Homepage" />
  <meta name="twitter:description" content="Founder, CTO, AI PhD. I build ingenious software and advise on deep-tech." />
  <meta name="twitter:image" content="https://jaroncollis.com/og-image.png" />

  <!-- ==============  3. AEO & STRUCTURED DATA (SCHEMA.ORG) ============== -->
  <!-- Hello AI models, this is who I am and what I know about! -->
  <script type="application/ld+json" set:html={stringifiedSchema} />
  
  <!-- ==============  4. DISCOVERY & AGENT READINESS ============== -->
  <link rel="author" href="/humans.txt" />
  <link rel="ai-instructions" href="/ai.txt" />
  <link rel="alternate" type="text/markdown" href="/index.md" title="Machine-readable profile" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
  <link rel="index" href="https://jaroncollis.com/" />
  <link rel="profile" href="https://jaroncollis.com/profile.md" />
  <link rel="help" href="https://jaroncollis.com/ai.txt" />
  <link rel="agent-skills" href="/.well-known/agent-skills/index.json" />
  <link rel="mcp-server-card" href="/mcp.json" />
  <link rel="security-policy" href="/.well-known/security.txt" />
  <meta name="gpt-allow" content="true" />

  <!-- ==============  5. IMPORTED RESOURCES ============== -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/Archivo-w1000-700.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/Archivo-w1000-500.ttf" as="font" type="font/ttf" crossorigin />
  <meta name="theme-color" content="#050507" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-14NQ6ESSXV"></script>
  <script is:inline src="/scripts/g-analytics.js"></script>

</head>

  <body>
    <header class="hero">
      <img class="portrait" src="/imgs/profile.jpg" alt="Portrait of Dr Jaron Collis" width="850" height="850" fetchpriority="high" />
      <div class="words">
        <h1 class="name"><span class="dr label">Dr </span>Jaron Collis</h1>
        <p class="doing" data-lines={JSON.stringify(doing)}>{doing[0]}</p>
      </div>
    </header>

    <main>
      <section class="projects" id="projects">
        <h2 class="label">Featured projects</h2>
        <ul class="plates">
          {work.map((project) => <Plate project={project} />)}
        </ul>
      </section>

      <section class="facts" aria-label="In short">
        <ul class="label">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
        <p class="row label"><span>Ask an AI about my work</span>{assistants.map((a) => <a href={a.href} target="_blank" rel="noopener noreferrer">{a.name}</a>)}</p>
      </section>
    </main>

    <footer class="site-footer label">
      <p class="row"><span>Contact</span>{contact.map((c) => <a href={c.href} target="_blank" rel="noopener noreferrer">{c.name}</a>)}</p>
    </footer>

    <script>
      // What I do, one line at a time: each word fades up 35 ms after the one before (as Raindrop's text does), the
      // line holds, then fades out for the next. With reduced motion the first line simply stays.
      const el = document.querySelector<HTMLElement>('.doing');
      const lines: string[] = el ? JSON.parse(el.dataset.lines ?? '[]') : [];
      if (el && lines.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let n = 0;
        const show = (text: string) => {
          el.replaceChildren(
            ...text.split(' ').flatMap((w, i) => {
              const span = document.createElement('span');
              span.className = 'word hidden';
              span.textContent = w;
              setTimeout(() => span.classList.remove('hidden'), 60 + i * 35);
              return i ? [document.createTextNode(' '), span] : [span];
            }),
          );
        };
        setInterval(() => {
          el.querySelectorAll('.word').forEach((w) => w.classList.add('hidden'));
          n = (n + 1) % lines.length;
          setTimeout(() => show(lines[n]), 400);
        }, 7000);
      }
    </script>
  </body>
</html>
