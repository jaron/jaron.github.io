---
// Raindrop's logotype, as on its own landing page (raindrop/lab/src/components/Masthead.astro): "Raindrop" glowing
// signal blue, with the i's dot drawn as a raindrop over a dotless ı. Readers and search engines get the word as spelt.
---

<span class="raindrop-mark">
  <span class="said">Raindrop</span><span aria-hidden="true"
    >Ra<span class="i">ı<svg viewBox="0 0 140 184"><path d="M70 0C55 25 0 72 0 114a70 70 0 0 0 140 0C140 72 85 25 70 0Z"></path></svg></span>ndrop</span
  >
</span>

<style>
  .raindrop-mark {
    display: inline-block;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: var(--ember);
    text-shadow:
      0 0 0.02em rgb(124 186 255 / 0.9),
      0 0 0.1em rgb(0 122 255 / 0.9),
      0 0 0.3em rgb(0 122 255 / 0.55),
      0 0 0.8em rgb(0 122 255 / 0.3);
  }

  .said {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .i {
    position: relative;
  }

  /* Placed from Archivo Bold's metrics, as on Raindrop's page. */
  .i svg {
    position: absolute;
    left: 0.0635em;
    top: 0.091em;
    width: 0.14em;
    height: 0.184em;
    overflow: visible;
    fill: currentColor;
    filter: drop-shadow(0 0 0.02em rgb(124 186 255 / 0.9)) drop-shadow(0 0 0.1em rgb(0 122 255 / 0.9))
      drop-shadow(0 0 0.3em rgb(0 122 255 / 0.55));
  }
</style>
